<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>吴柏鑫 · 自我介绍</title>
  <link rel="stylesheet" href="card.css">
   <style>
.intro {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--accent); 
  background: #eaf3de;
  border-left: 3px solid #ba7517;
  padding: 10px 12px;
  border-radius: 6px;
  min-height: 3.5em;
}
.caret {
  display: inline-block;
  width: 7px; height: 1em;
  background: var(--accent);
  vertical-align: -2px;
  animation: blink 1s steps(1) infinite;
}
@keyframes blink { 0%,50%{opacity:1} 51%,100%{opacity:0} }
.tags li { transition: transform .2s, background .2s; }
.tags li:hover { transform: translateY(-3px); background: var(--accent); color: #fff; }
.badge {
  height: 1.2em;      /* 跟随字号，永远和标签文字等高 */
  width: auto;
  display: block;
  flex: 0 0 auto;
  background: #fff;   /* 校徽内部镂空，垫白底，hover 变蓝时才看得见 */
  border-radius: 4px;
  padding: 1px;
}
</style>
</head>
<body style="--accent: #185fa5">
  <p class="eyebrow">ABOUT ME / 03</p>
  <h2>吴柏鑫</h2>
  <p class="class-name">电子2603</p>
  <!-- TODO：完成下面的介绍、三个技能或兴趣标签，以及学习目标。 -->
 <p class="intro"><span id="typed"></span><span class="caret"></span></p>
  <ul class="tags" aria-label="我的技能和兴趣">
  <li><span class="flip">南工大<img class="badge" src="njtech-logo.png" alt="南京工业大学校徽"></span></li>
  <li class="tag-grass"><span class="flip">绿荫工作室</span></li>
  <li><span class="flip">申铭清<span class="heart" aria-hidden="true"></span></span></li>
</ul>
 <p class="goal"><strong>我想学会</strong>不断进步，超越昨天的自己。</p>
<script>
const text = '我是吴柏鑫。以好奇为灯，以坚持为路，慢慢长成自己喜欢的样子。';
const el = document.getElementById('typed');
let i = 0, deleting = false;

function loop() {
  el.textContent = text.slice(0, i);
  if (!deleting) {
    i++;
    if (i > text.length) { deleting = true; setTimeout(loop, 1000); return; }
    setTimeout(loop, 60);
  } else {
    i--;
    if (i < 0) { deleting = false; i = 0; setTimeout(loop, 700); return; }
    setTimeout(loop, 30);
  }
}
loop();
</script>
</body>
</html>
